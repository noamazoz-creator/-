@media(max-width:480px){.container{width:calc(100% - 28px)}h1{font-size:clamp(2.35rem,11vw,3.2rem)}.hero-cta{align-items:stretch}.hero-cta .button{width:100%}.small-note{width:100%}.visual-card{min-height:365px;padding:14px;border-radius:25px}.mock{padding:17px;max-width:310px}.floating{max-width:215px;font-size:.82rem}.problem-row{grid-template-columns:48px 1fr;gap:13px}.num{width:42px;height:42px;border-radius:13px}.cta-panel{padding:25px 18px;border-radius:24px}.form-card{padding:20px 16px}.footer-inner{align-items:flex-start;flex-direction:column;gap:7px}}
