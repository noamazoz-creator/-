*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,"Noto Sans Hebrew",sans-serif;line-height:1.6}.container{width:min(1120px,calc(100% - 40px));margin:auto}.hero{padding:28px 0 76px;background:radial-gradient(circle at 7% 20%,#d8f07855,transparent 23%),radial-gradient(circle at 91% 65%,#f7e7d8,transparent 25%),var(--paper)}.brand{display:inline-flex;align-items:center;gap:10px;font-weight:800;font-size:1.05rem}.mark{display:grid;place-items:center;width:38px;height:38px;border-radius:13px;background:var(--green);color:var(--lime);font-size:1.3rem}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:clamp(36px,6vw,84px);padding-top:68px}.eyebrow{display:inline-flex;align-items:center;gap:9px;padding:7px 13px;border:1px solid #dce6d9;border-radius:999px;color:var(--green);background:#ffffffb3;font-size:.88rem;font-weight:700}.dot{width:8px;height:8px;border-radius:50%;background:#84ad43}h1{margin:22px 0 18px;max-width:680px;font-size:clamp(2.5rem,5.2vw,4.65rem);line-height:1.08;letter-spacing:-.055em}h1 span{color:var(--green)}.hero-copy{margin:0;max-width:560px;color:var(--muted);font-size:clamp(1.05rem,1.6vw,1.23rem)}.hero-cta{margin-top:30px;display:flex;align-items:center;gap:15px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;padding:0 23px;border:0;border-radius:14px;background:var(--green);color:white;font:inherit;font-weight:800;text-decoration:none;cursor:pointer;transition:.18s;box-shadow:0 8px 20px #1f655229}.button:hover{background:var(--dark);transform:translateY(-2px)}.button:focus-visible,input:focus-visible{outline:3px solid #9ac65c;outline-offset:3px}.small-note{color:var(--muted);font-size:.88rem}.visual-card{position:relative;min-height:420px;border-radius:34px;padding:25px;background:#e4eddf;overflow:hidden;box-shadow:var(--shadow);isolation:isolate}.visual-card:before{content:"";position:absolute;width:330px;height:330px;border-radius:50%;background:var(--lime);top:-105px;left:-75px;z-index:-1}.visual-card:after{content:"";position:absolute;width:230px;height:230px;border-radius:50%;background:#b6d2bf;right:-60px;bottom:-75px;z-index:-1}.mock{position:relative;max-width:360px;margin:30px auto 0;background:white;border:1px solid #182b2814;border-radius:23px;padding:21px;box-shadow:0 20px 45px #182b2821;transform:rotate(2deg)}.mock-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}.muted{font-size:.83rem;color:var(--muted)}.pill{background:#edf6d7;color:#42682a;border-radius:99px;padding:5px 10px;font-size:.75rem;font-weight:700}.mock-title{font-size:1.2rem;font-weight:800;margin-bottom:5px}.mock-sub{font-size:.86rem;color:var(--muted);margin-bottom:18px}.mock-row{display:flex;align-items:center;gap:12px;border-top:1px solid #edf0eb;padding:13px 0}.mock-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:#f3f5e9;font-size:1.2rem}.mock-row strong{display:block;font-size:.9rem}.mock-row small{color:var(--muted);font-size:.78rem}.floating{position:absolute;bottom:27px;right:2px;display:flex;align-items:center;gap:11px;max-width:240px;padding:14px 17px;border:1px solid #182b280f;border-radius:17px;background:white;box-shadow:0 12px 35px #182b281a;font-weight:700;font-size:.9rem}.check{width:30px;height:30px;display:grid;place-items:center;flex:none;border-radius:50%;background:var(--lime);color:var(--dark)}section{padding:78px 0}.problem{background:white}.heading{max-width:660px;margin-bottom:35px}.kicker{color:var(--green);font-weight:800;font-size:.85rem;margin-bottom:9px}h2{margin:0;font-size:clamp(1.9rem,3.3vw,2.8rem);line-height:1.2;letter-spacing:-.04em}.intro{color:var(--muted);margin:14px 0 0;font-size:1.05rem}.problem-list{display:grid;border-top:1px solid var(--line)}.problem-row{display:grid;grid-template-columns:70px 1fr;gap:18px;align-items:center;padding:23px 0;border-bottom:1px solid var(--line)}.num{width:48px;height:48px;display:grid;place-items:center;border-radius:16px;background:#f1f4eb;color:var(--green);font-size:1.15rem;font-weight:800}.problem-row p{margin:0;font-size:clamp(1rem,1.5vw,1.14rem)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.step{padding:26px;background:white;border:1px solid var(--line);border-radius:24px;min-height:220px}.step-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}.step-num{color:var(--green);font-weight:900;font-size:.9rem}.step-icon{width:48px;height:48px;display:grid;place-items:center;border-radius:16px;background:#edf4e8;font-size:1.35rem}.step h3{margin:0 0 8px;font-size:1.15rem}.step p{margin:0;color:var(--muted);font-size:.96rem}.cta-section{padding:0 0 82px}.cta-panel{display:grid;grid-template-columns:1fr minmax(300px,.8fr);gap:40px;align-items:center;padding:clamp(26px,5vw,55px);border-radius:30px;background:var(--green);color:white;position:relative;overflow:hidden}.cta-panel:after{content:"";position:absolute;width:270px;height:270px;border:1px solid #d8f0783d;border-radius:50%;left:-100px;bottom:-160px;pointer-events:none}.cta-panel p{color:#d9e8df;margin:15px 0 0;max-width:460px}.cta-panel .kicker{color:var(--lime)}.form-card{position:relative;z-index:1;background:white;color:var(--ink);padding:25px;border-radius:21px}.form-card h3{margin:0 0 5px;font-size:1.15rem}.form-intro{margin:0 0 20px;color:var(--muted);font-size:.9rem}.field{margin-bottom:14px}label{display:block;margin-bottom:6px;font-size:.9rem;font-weight:700}input{width:100%;min-height:49px;border:1px solid #d6dfd6;border-radius:11px;padding:11px 13px;background:#fbfcf9;color:var(--ink);font:inherit;direction:rtl}input::placeholder{color:#8b9992}.form-card .button{width:100%;margin-top:4px}.privacy{margin:12px 0 0;text-align:center;color:var(--muted);font-size:.78rem}.message{padding:18px;border-radius:14px;background:#f1f7e6;color:var(--dark)}.message h3{margin:0 0 6px}.message p{margin:0;font-size:.93rem}.message.error{background:#fff0eb;color:#8b3420}.message[hidden],form[hidden]{display:none!important}footer{padding:24px 0 32px;color:var(--muted);font-size:.85rem}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid var(--line);padding-top:22px}.footer-brand{color:var(--ink);font-weight:800}
